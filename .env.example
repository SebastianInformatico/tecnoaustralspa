# Credenciales OAuth de Zoho Mail. Nunca las expongas en el navegador.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNT_ID=
# Debe ser una dirección asociada a la cuenta Zoho autenticada.
ZOHO_FROM_EMAIL=
# El correo del cliente se usa automáticamente como destinatario principal.
# Opcional: ID de la firma configurada en Zoho Mail.
ZOHO_SIGNATURE_ID=
# Para cuentas de otros centros de datos, cambia estos dominios.
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_MAIL_API_DOMAIN=https://mail.zoho.com
